{
  "manifest_version": 3,
  "name": "KGP ERP Login Helper",
  "version": "1.3.1",
  "minimum_chrome_version": "106",
  "description": "Encrypted ERP credentials and optional automatic OTP login through this Chrome profile's Gmail.",
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "KGP ERP Login"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://erp.iitkgp.ac.in/SSOAdministration/login.htm*"
      ],
      "js": [
        "form-helper.js",
        "auto-content.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "455069330085-4gjgpacioa826itjc68i7mbnsnjceopt.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.readonly"
    ]
  }
}
